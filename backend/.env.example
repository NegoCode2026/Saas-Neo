PORT=4000
NODE_ENV="development"
DATABASE_URL="postgresql://stocklocal:stocklocal@localhost:5432/stocklocal"
# OBLIGATORIO en producción: mín. 32 caracteres, único por entorno.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA commitear el valor real. En Render/Vercel va como variable de entorno.
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
FRONTEND_URL="http://localhost:3000"

# Email (opcional). Sin RESEND_API_KEY el link de recuperación se imprime en consola.
# RESEND_API_KEY es SECRETO de servidor: jamás usar NEXT_PUBLIC_ ni enviarlo al frontend.
RESEND_API_KEY=""
EMAIL_FROM="StockLocal <onboarding@resend.dev>"
